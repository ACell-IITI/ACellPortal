# Backend environment variables
APP_ENV=development
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://alumnicell.iiti.ac.in

# Database
MONGO_URI=your_mongodb_uri
MONGODB_LINK=your_fallback_mongodb_uri

# Security
JWT_SECRET=your_jwt_secret

# Optional provider settings
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
# CLOUDINARY_API_KEY=your_cloudinary_api_key
# CLOUDINARY_API_SECRET=your_cloudinary_api_secret
# OPENINARY_API_KEY=your_openinary_api_key
# OPENINARY_URL=https://api.openinary.com/your-endpoint
